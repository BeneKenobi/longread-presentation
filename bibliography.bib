@article{ZhengEtAlBioinformaticsHumanLongread2026,
  title = {Bioinformatics for Human Long-Read Whole-Genome Sequencing},
  author = {Zheng, Xinchang and Sanio, Philippe and Luo, Ruibang and Li, Heng and Sedlazeck, Fritz J.},
  date = {2026-09-10},
  journaltitle = {Nature Reviews Methods Primers},
  shortjournal = {Nat Rev Methods Primers},
  volume = {6},
  number = {1},
  pages = {70},
  publisher = {Nature Publishing Group},
  issn = {2662-8449},
  doi = {10.1038/s43586-026-00519-x},
  abstract = {Despite two decades of large-scale sequencing studies, a substantial fraction of genetic risk for many human diseases remains unexplained. This gap reflects a continued focus on easily accessible variant classes and genomic regions, whereas complex forms of variation, including structural variants, tandem repeats, haplotype-specific effects and epigenetic modifications, remain under-characterized. Long-read sequencing enables direct observation of contiguous DNA molecules, providing access to these previously under-represented dimensions of genomic variation within their native context across often ignored regions of the dark genome. In this Primer, we outline the computational foundations of long-read whole-genome analysis in human genomics, spanning read processing, mapping, de novo assembly, multi-class variant detection, haplotype phasing, repeat analysis and epigenetic profiling. We highlight key analytical trade-offs between mapping-based and assembly-based approaches, discuss emerging graph and pangenome frameworks that reduce reference bias, and examine current challenges in variant interpretation, benchmarking and assembly quality assessment. By expanding the spectrum of detectable variation and enabling sequence-resolved, haplotype-aware analysis, long-read genomics provides a framework for systematically interrogating previously overlooked sources of genetic and regulatory variation, inviting us for a long read through the dark genome.}
}
@article{MahmoudEtAlHitchhikersGuideLongread2025,
  title = {A {{Hitchhiker}}'s {{Guide}} to Long-Read Genomic Analysis},
  author = {Mahmoud, Medhat and Agustinho, Daniel P. and Sedlazeck, Fritz J.},
  date = {2025-04-14},
  journaltitle = {Genome Research},
  volume = {35},
  number = {4},
  pages = {545--558},
  publisher = {Cold Spring Harbor Laboratory Press},
  issn = {1088-9051, 1549-5469},
  doi = {10.1101/gr.279975.124},
  abstract = {{$<$}p{$>$}Over the past decade, long-read sequencing has evolved into a pivotal technology for uncovering the hidden and complex regions of the genome. Significant cost efficiency, scalability, and accuracy advancements have driven this evolution. Concurrently, novel analytical methods have emerged to harness the full potential of long reads. These advancements have enabled milestones such as the first fully completed human genome, enhanced identification and understanding of complex genomic variants, and deeper insights into the interplay between epigenetics and genomic variation. This mini-review provides a comprehensive overview of the latest developments in long-read DNA sequencing analysis, encompassing reference-based and de novo assembly approaches. We explore the entire workflow, from initial data processing to variant calling and annotation, focusing on how these methods improve our ability to interpret a wide array of genomic variants. Additionally, we discuss the current challenges, limitations, and future directions in the field, offering a detailed examination of the state-of-the-art bioinformatics methods for long-read sequencing.{$<$}/p{$>$}}
}
@article{FuEtAlComputationalAnalysisDNA2025,
  title = {Computational Analysis of {{DNA}} Methylation from Long-Read Sequencing},
  author = {Fu, Yilei and Timp, Winston and Sedlazeck, Fritz J.},
  date = {2025-09},
  journaltitle = {Nature Reviews Genetics},
  shortjournal = {Nat Rev Genet},
  volume = {26},
  number = {9},
  pages = {620--634},
  publisher = {Nature Publishing Group},
  issn = {1471-0064},
  doi = {10.1038/s41576-025-00822-5},
  abstract = {DNA methylation is a critical epigenetic mechanism in numerous biological processes, including gene regulation, development, ageing and the onset of various diseases such as cancer. Studies of methylation are increasingly using single-molecule long-read sequencing technologies to simultaneously measure epigenetic states such as DNA methylation with genomic variation. These long-read data~sets have spurred the continuous development of advanced computational methods to gain insights into the roles of methylation in regulating chromatin structure and gene regulation. In this Review, we discuss the computational methods for calling methylation signals, contrasting methylation between samples, analysing cell-type diversity and gaining additional genomic insights, and then further discuss the challenges and future perspectives of tool development for DNA methylation research.}
}
