@article{ZhengEtAlBioinformaticsHumanLongread2026,
  title = {Bioinformatics for Human Long-Read Whole-Genome Sequencing},
  author = {Zheng, Xinchang and Sanio, Philippe and Luo, Ruibang and Li, Heng and Sedlazeck, Fritz J.},
  date = {2026-09-10},
  journaltitle = {Nature Reviews Methods Primers},
  shortjournal = {Nat Rev Methods Primers},
  volume = {6},
  number = {1},
  pages = {70},
  publisher = {Nature Publishing Group},
  issn = {2662-8449},
  doi = {10.1038/s43586-026-00519-x},
  abstract = {Despite two decades of large-scale sequencing studies, a substantial fraction of genetic risk for many human diseases remains unexplained. This gap reflects a continued focus on easily accessible variant classes and genomic regions, whereas complex forms of variation, including structural variants, tandem repeats, haplotype-specific effects and epigenetic modifications, remain under-characterized. Long-read sequencing enables direct observation of contiguous DNA molecules, providing access to these previously under-represented dimensions of genomic variation within their native context across often ignored regions of the dark genome. In this Primer, we outline the computational foundations of long-read whole-genome analysis in human genomics, spanning read processing, mapping, de novo assembly, multi-class variant detection, haplotype phasing, repeat analysis and epigenetic profiling. We highlight key analytical trade-offs between mapping-based and assembly-based approaches, discuss emerging graph and pangenome frameworks that reduce reference bias, and examine current challenges in variant interpretation, benchmarking and assembly quality assessment. By expanding the spectrum of detectable variation and enabling sequence-resolved, haplotype-aware analysis, long-read genomics provides a framework for systematically interrogating previously overlooked sources of genetic and regulatory variation, inviting us for a long read through the dark genome.}
}
